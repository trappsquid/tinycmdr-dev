# tinycmdr secrets - copy to .env and fill in. Never commit or share this file.
# Environment variables override config.json, so tokens live here, not there.

# Mattermost bot token (System Console -> Integrations -> Bot Accounts).
# The bot account must be in the team/channel you want it in.
tinycmdr_MM_TOKEN=

# Optional: point the agent at a different model/endpoint without editing config
#tinycmdr_MODEL=main
#tinycmdr_BASE_URL=http://127.0.0.1:8081/v1

# Optional: cloud fallback keys (only used if llm.allow_cloud_fallback is true)
#DEEPSEEK_API_KEY=

# Optional: web search
#TAVILY_API_KEY=
#ANYSEARCH_API_KEY=
