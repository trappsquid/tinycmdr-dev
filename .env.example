# tinycmdr secrets - copy to .env and fill in. Never commit or share this file.
# Environment variables override config.json, so tokens live here, not there.

# Mattermost bot token (System Console -> Integrations -> Bot Accounts).
# The bot account must be in the team/channel you want it in.
TINYCMDR_MM_TOKEN=

# The page's access token. The installer mints one, and so does the first start
# of a host that has none (an install that upgraded into the page); rotating it
# is `tinycmdr token set TINYCMDR_WEB_TOKEN` (an empty value mints a fresh one and
# prints the new link). No token means the page does not start - never an open
# port. `tinycmdr setup` asks about the page's bind (loopback or LAN) and prints
# the link.
TINYCMDR_WEB_TOKEN=

# Telegram bot token (an optional second chat lane). The numeric allowlist it needs is
# config.json's telegram.allowed_users: the bot ignores every DM until that has an id.
#TINYCMDR_TG_TOKEN=

# The primary endpoint's key, when the endpoint needs one. This overrides llm.api_key in
# config.json, so the key lives in the one secrets file (a copy in config.json is a copy
# the agent can read into a prompt).
#TINYCMDR_LLM_API_KEY=

# Optional: point the agent at a different model/endpoint without editing config
#TINYCMDR_MODEL=main
#TINYCMDR_BASE_URL=http://127.0.0.1:8081/v1

# Optional: cloud fallback keys (only used if llm.allow_cloud_fallback is true).
# No provider is named on purpose: the variable is whatever your fallback entry's
#"api_key_env" says - name it after the endpoint you actually use.
#MY_PROVIDER_API_KEY=

# Optional: web search. Search is OFF unless the operator allows it to leave this machine
# (search.allow_cloud_egress, or the installer's question / --search-egress true); a provider
# on your LAN never needs that. Keys live here, never in config.json.
#TAVILY_API_KEY=
#ANYSEARCH_API_KEY=
#TINYCMDR_SEARCH_EGRESS=true
#TINYCMDR_SEARCH_PROVIDERS=[{"kind":"searxng","url":"http://127.0.0.1:8080"}]
