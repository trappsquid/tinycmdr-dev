#!/bin/sh
# tinycmdr - the door on Linux and macOS. On PATH (the installer puts it there):
#     tinycmdr                     the PAGE (no arguments; opens in your browser), and
#                                  the chat lanes when this box has any
#     tinycmdr cli                 the console alone: the session, no page
#     tinycmdr --app               the full-screen session alone, no page
#     tinycmdr status | doctor | model | logs | restart | token | help
#     tinycmdr --no-web            the same as bare, without the page for this run
# No arguments means the page: the page is the default door, and a terminal session is
# the deliberate choice (`tinycmdr cli`). Until 2026-10-04 this shim added `--app` for the
# bare case, so the app and the page opened at once. The bot keeps
# starting the way it always has (systemd/launchd run tinycmdr.py itself, never this shim).
#
# A shim, not a second build: it runs tinycmdr.py from the folder it RESOLVES to, so a
# symlink in /usr/local/bin finds the install rather than the bin directory.
set -eu

SELF="$0"
while [ -L "$SELF" ]; do
    LINK="$(readlink "$SELF")"
    case "$LINK" in
        /*) SELF="$LINK" ;;
        *) SELF="$(dirname "$SELF")/$LINK" ;;
    esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"
case "$(uname -s 2>/dev/null)" in
    *MINGW*|*MSYS*|*CYGWIN*)
        if command -v cygpath >/dev/null 2>&1; then
            HERE="$(cygpath -w "$HERE")"
        fi
        ;;
esac

PY="${TINYCMDR_PYTHON:-}"
if [ -z "$PY" ]; then
    # A candidate is only a python if it can RUN: on a host with the Windows Store
    # app-alias shim, /usr/bin/python3 exists and prints an advert instead.
    for c in "$HERE/venv/bin/python" "$HERE/.python/bin/python3" \
             /usr/bin/python3 /usr/local/bin/python3; do
        if [ -x "$c" ] && "$c" -c "import sys" >/dev/null 2>&1; then PY="$c"; break; fi
    done
fi
if [ -z "$PY" ]; then
    for c in python3 python; do
        if command -v "$c" >/dev/null 2>&1 && "$c" -c "import sys" >/dev/null 2>&1; then PY="$(command -v "$c")"; break; fi
    done
fi
if [ -z "$PY" ]; then
    echo "tinycmdr: no python found - set TINYCMDR_PYTHON to an interpreter" >&2
    exit 127
fi

# THE RULE: every user, on every released version, types `tinycmdr update` and it works. An
# old install's own updater may predate the release package (1.0.46-1.0.48 shelled out to
# `git pull`, which refused on their own dirty checkout), so when the local code cannot do
# the job this shim fetches the published updater and lets IT do the whole thing. The
# probe is a marker, not a version compare: what matters is whether this copy has the
# packaged updater at all.
# The probe is a CAPABILITY marker, not a verb name: measured against a real 1.0.44 payload
# (2026-10-03), that version HAS an `update` verb - one that shells out to `git pull`, which
# dead-ends on the dirty checkout its own installer leaves behind - and has no
# `releases/latest/download` anywhere in it. So the question is "can this copy fetch a
# release package at all", and only the packaged updater can.
if [ "${1:-}" = "update" ] && ! grep -q "releases/latest/download" "$HERE/tinycmdr.py" 2>/dev/null; then
    V="$(grep -m1 '^VERSION' "$HERE/tinycmdr.py" 2>/dev/null | sed 's/.*"\(.*\)".*/\1/')"
    echo "tinycmdr: this install (${V:-unknown version}) predates the packaged updater - using the published one"
    UPD="$(mktemp)"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "https://github.com/trappsquid/tinycmdr/releases/latest/download/update.sh" -o "$UPD" || { rm -f "$UPD"; echo "tinycmdr: could not fetch the updater" >&2; exit 1; }
    elif command -v wget >/dev/null 2>&1; then
        wget -q "https://github.com/trappsquid/tinycmdr/releases/latest/download/update.sh" -O "$UPD" || { rm -f "$UPD"; echo "tinycmdr: could not fetch the updater" >&2; exit 1; }
    else
        echo "tinycmdr: neither curl nor wget is available to update with" >&2; exit 1
    fi
    sh "$UPD" "$HERE"
    RC=$?
    rm -f "$UPD"
    exit $RC
fi

# Nothing is added for the bare case: the build's no-argument start is the page.
exec "$PY" "$HERE/tinycmdr.py" "$@"
