#!/bin/sh
# tinycmdr - the door on Linux and macOS. On PATH (the installer puts it there):
#     tinycmdr                     a session in this folder (no arguments)
#     tinycmdr status | doctor | model | logs | restart | token | help
#     tinycmdr --cli               the same session, spelled out
# No arguments is the human case, so it opens a session; the bot keeps starting the
# way it always has (systemd/launchd run tinycmdr.py itself, never this shim).
#
# A shim, not a second build: it runs tinycmdr.py from the folder it RESOLVES to, so a
# symlink in /usr/local/bin finds the install rather than the bin directory.
set -eu

SELF="$0"
while [ -L "$SELF" ]; do
    LINK="$(readlink "$SELF")"
    case "$LINK" in
        /*) SELF="$LINK" ;;
        *) SELF="$(dirname "$SELF")/$LINK" ;;
    esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"
case "$(uname -s 2>/dev/null)" in
    *MINGW*|*MSYS*|*CYGWIN*)
        if command -v cygpath >/dev/null 2>&1; then
            HERE="$(cygpath -w "$HERE")"
        fi
        ;;
esac

PY="${TINYCMDR_PYTHON:-}"
if [ -z "$PY" ]; then
    # A candidate is only a python if it can RUN: on a host with the Windows Store
    # app-alias shim, /usr/bin/python3 exists and prints an advert instead.
    for c in "$HERE/venv/bin/python" "$HERE/.python/bin/python3" \
             /usr/bin/python3 /usr/local/bin/python3; do
        if [ -x "$c" ] && "$c" -c "import sys" >/dev/null 2>&1; then PY="$c"; break; fi
    done
fi
if [ -z "$PY" ]; then
    for c in python3 python; do
        if command -v "$c" >/dev/null 2>&1 && "$c" -c "import sys" >/dev/null 2>&1; then PY="$(command -v "$c")"; break; fi
    done
fi
if [ -z "$PY" ]; then
    echo "tinycmdr: no python found - set TINYCMDR_PYTHON to an interpreter" >&2
    exit 127
fi

if [ "$#" -eq 0 ]; then
    exec "$PY" "$HERE/tinycmdr.py" --cli
fi
exec "$PY" "$HERE/tinycmdr.py" "$@"
